# install.sh writes this file for you. To do it by hand: copy to .env and fill in.

# Domain pointing at this server. Without your own domain use <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-7.sslip.io. Caddy issues HTTPS for it.
DOMAIN=locket.example.com
# The same address as the app sees it.
PUBLIC_URL=https://locket.example.com

# Apple Push Notifications (developer.apple.com → Keys → "+" → Apple Push Notifications service).
# Put the downloaded AuthKey_XXXXXXXXXX.p8 into ./secrets/AuthKey.p8
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
# Bundle ID of the iOS app (BUNDLE_ID in ios/project.yml)
APNS_TOPIC=com.example.locket

# Week schedule: results on Sunday (7) at 21:00, Moscow time (UTC+3 = 180 min).
TZ_OFFSET_MINUTES=180
WEEK_END_DAY=7
WEEK_END_HOUR=21
# "Hurry up and vote" reminder this many hours before results (0 = off)
REMINDER_HOURS_BEFORE=3
